{
    "manifestVersion": 1,
    "id": "accuknox-unified-scan",
    "name": "AccuKnox Unified Scan",
    "version": "1.0.0",
    "publisher": "AccuKnox",
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "description": "Run SAST, SCA, Secret, IaC, ML and SBOM scans in one Azure DevOps task, upload results to the AccuKnox Console and enforce AccuKnox quality gates.",
    "categories": [
        "Azure Pipelines"
    ],
    "icons": {
        "default": "images/logo.png"
    },
    "files": [
        {
            "path": "src"
        }
    ],
    "contributions": [
        {
            "id": "accuknox-unified-scan",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "src"
            }
        }
    ],
    "public": true,
    "content": {
        "details": {
            "path": "overview.md"
        }
    }
}
